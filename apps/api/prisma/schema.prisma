generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  passwordHash String? @map("password_hash")
  googleId     String? @unique @map("google_id")
  name         String
  affiliation  String?

  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  conferences   Conference[]
  papers        Paper[]

  @@map("users")
}

model RefreshToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique @map("token_hash")
  familyId  String @map("family_id") @db.Uuid

  revoked   Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  actorId String? @map("actor_id") @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action AuditAction

  entityType String? @map("entity_type")
  entityId   String? @map("entity_id") @db.Uuid

  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

model Conference {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  location    String?

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  tracks Track[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdById])
  @@map("conferences")
}

model Track {
  id String @id @default(uuid()) @db.Uuid

  conferenceId String     @map("conference_id") @db.Uuid
  conference   Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)

  name        String
  description String?

  papers Paper[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([conferenceId])
  @@map("tracks")
}

model Paper {
  id String @id @default(uuid()) @db.Uuid

  title    String
  abstract String
  keywords String[]

  trackId String @map("track_id") @db.Uuid
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  authorId String @map("author_id") @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  status PaperStatus @default(DRAFT)

  authors  PaperAuthor[]
  versions PaperVersion[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([trackId])
  @@index([authorId])
  @@map("papers")
}

model PaperAuthor {
  id String @id @default(uuid()) @db.Uuid

  paperId String @map("paper_id") @db.Uuid
  paper   Paper  @relation(fields: [paperId], references: [id], onDelete: Cascade)

  name        String
  email       String
  affiliation String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([paperId])
  @@map("paper_authors")
}

model PaperVersion {
  id String @id @default(uuid()) @db.Uuid

  paperId String @map("paper_id") @db.Uuid
  paper   Paper  @relation(fields: [paperId], references: [id], onDelete: Cascade)

  versionNumber Int @map("version_number")

  fileUrl  String @map("file_url")
  fileName String @map("file_name")

  uploadedAt DateTime @default(now()) @map("uploaded_at")

  @@index([paperId])
  @@map("paper_versions")
}

enum PaperStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  PASSWORD_CHANGED
  OAUTH_LINKED
  REFRESH_TOKEN_REUSE_DETECTED
  ACCOUNT_LOCKED
}
