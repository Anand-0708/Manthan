// Manthan — Prisma schema
// Phase 1 scope: Auth & Users only.
// Conference/Paper/Review/Decision models are added in Phase 2+ as each
// business module is implemented — see the development roadmap.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A registered user of the platform. Role (Author/Reviewer/Chair) is NOT
/// stored here — it's contextual per-conference via ConferenceRole, added
/// in Phase 2. A user with no conference roles yet can still authenticate
/// and manage their profile.
model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  /// Null for users who signed up via Google OAuth only (no password set).
  passwordHash String? @map("password_hash")
  /// Null for users who signed up with email+password only.
  googleId     String? @unique @map("google_id")
  name         String
  affiliation  String?

  /// Simple brute-force protection: incremented on failed login, reset on
  /// success. lockedUntil blocks login attempts until that timestamp passes.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  conferences   Conference[]

  @@map("users")
}

/// Refresh tokens are never stored in plaintext — only a SHA-256 hash, so a
/// database leak doesn't expose usable tokens (same principle as password
/// hashing). `familyId` groups all tokens issued from a single login, so
/// that if a used/expired token is replayed (reuse detection), the entire
/// family can be revoked at once rather than just the one token.
model RefreshToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique @map("token_hash")
  familyId  String @map("family_id") @db.Uuid

  revoked   Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Security-relevant events for incident response and traceability.
/// Scoped to auth events in Phase 1 — business-workflow actions
/// (PAPER_SUBMITTED, REVIEWER_ASSIGNED, DECISION_MADE, etc.) are added to
/// this same enum/table when their owning module is implemented, so
/// there's a single audit trail rather than one per module.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  /// Null for pre-authentication events, e.g. a failed login for an email
  /// that may not even correspond to a real account.
  actorId String? @map("actor_id") @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action AuditAction

  entityType String? @map("entity_type")
  entityId   String? @map("entity_id") @db.Uuid

  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

model Conference {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  location    String?

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdById])
  @@map("conferences")
}

/// Extended module-by-module as each business module is implemented.
/// Phase 1 only defines the auth-related events.
enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  PASSWORD_CHANGED
  OAUTH_LINKED
  REFRESH_TOKEN_REUSE_DETECTED
  ACCOUNT_LOCKED
}
