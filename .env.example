POSTGRES_USER=manthan
POSTGRES_PASSWORD=manthan123
POSTGRES_DB=manthan_db

POSTGRES_PORT=5432
API_PORT=4000
WEB_PORT=3000

DATABASE_URL=postgresql://manthan:manthan123@postgres:5432/manthan_db

# ==========================
# JWT
# ==========================
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ==========================
# Frontend
# ==========================
CLIENT_URL=http://localhost:3000

# ==========================
# CORS
# ==========================
CORS_ORIGIN=http://localhost:3000

# ==========================
# Cookie
# ==========================
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ==========================
# Email (SMTP)
# ==========================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ==========================
# File Upload / S3 / MinIO
# ==========================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=

# ==========================
# Application
# ==========================
NODE_ENV=development
LOG_LEVEL=info-